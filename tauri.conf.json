{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThorBro",
  "version": "0.2.0",
  "identifier": "io.github.thorbro",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ThorBro",
        "width": 980,
        "height": 760,
        "minWidth": 520,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Files, games and save sync for the AYN Thor"
  }
}
